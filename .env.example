# Copy this file to .env.local and fill in the values. .env.local is git-ignored.

# Required for the chat assistant. Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional overrides (defaults in lib/ai/config.ts)
# CHAT_MODEL=z-ai/glm-5.3-flash                   # any OpenRouter model id that supports tool calling
# CHAT_FALLBACK_MODELS=anthropic/claude-sonnet-5.5  # comma-separated; tried in order if the main model fails
# CHAT_EFFORT=low                                  # low | medium | high (reasoning effort, if the model supports it)
# CHAT_SCOPE_GUARD=on                              # set to "off" to skip the pre-check and rely on the system prompt only
# SITE_URL=https://your-domain.com                 # shown on your OpenRouter dashboard as the app's URL

# Memgraph knowledge graph (docs/memgraph/README.md). Defaults to a local Docker instance with no auth.
# MEMGRAPH_URI=bolt://localhost:7687
# MEMGRAPH_USER=
# MEMGRAPH_PASSWORD=
